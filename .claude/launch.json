{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "crm-landing",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "-p", "3456", "."],
      "port": 3456
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["api.main:app", "--port", "8000"],
      "port": 8000
    }
  ]
}
