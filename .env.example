# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost/axon_crm
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ── Property data sources ─────────────────────────────────────────────────────
# RentCast — seeds the address list and fills year_built/value/sale/owner.
RENTCAST_API_KEY=
# Attom — assessor detail; fills garage/lot AND value/sale/owner/year gaps.
ATTOM_API_KEY=
# Google Geocoding — fills latitude/longitude/geohash.
GOOGLE_GEOCODE_KEY=
# US Census ACS — fills zip_median_income. Optional; raises rate limits if set.
CENSUS_API_KEY=
# Harris County assessor DuckDB (free, local) — permits + pool/slab + backfill.
PERMIT_DB_PATH=/path/to/harris_county.duckdb

# ── Contact / skip-trace (fills contact_name/phone/email) ─────────────────────
# Leave CONTACT_PROVIDER empty to skip contact enrichment entirely.
# Supported: batchdata  (add more in pipeline/contact.py PROVIDERS)
CONTACT_PROVIDER=
CONTACT_API_KEY=
CONTACT_BASE_URL=
CONTACT_MAX_ROWS_PER_ZIP=200
# Optional: only skip-trace leads at/above this grade (A best). Empty = no gate.
CONTACT_MIN_GRADE=

# ── Cost / tuning knobs ───────────────────────────────────────────────────────
# Cap Attom (paid) lookups per ZIP.
ATTOM_MAX_ROWS_PER_ZIP=500
# Equity fallback fraction of value when no mortgage/sale data is available.
EQUITY_FALLBACK_PCT=0.6
# HTTP retry/backoff for all outbound API calls.
HTTP_RETRIES=3
HTTP_BACKOFF=0.5

# ── Seed property-type filter ─────────────────────────────────────────────────
# Only these RentCast propertyType values are seeded; everything else (Apartment,
# Multi-Family, Land, etc.) is skipped before paid enrichment. Set to * for all.
SEED_PROPERTY_TYPES=Single Family,Condo,Townhouse,Manufactured

# ── Search-area expansion (when a ZIP returns too few seed rows) ──────────────
SEED_EXPAND_ENABLED=true
SEED_EXPAND_THRESHOLD=50
SEED_EXPAND_TARGET=200
SEED_EXPAND_RADIUS_MI=5
SEED_EXPAND_MAX_ZIPS=10
