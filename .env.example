# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost/axon_crm
# REQUIRED: the API refuses to start without it. For local development only,
# you may instead set ALLOW_INSECURE_DEV_JWT=true.
JWT_SECRET_KEY=change-me-to-a-long-random-secret
# Max CSV import upload size in bytes (default 5 MB). Also caps Meta export uploads.
#IMPORT_MAX_BYTES=5242880
# Application log level (default INFO). INFO surfaces per-step pipeline progress
# and the timing table each run emits; DEBUG adds provider-level HTTP detail.
#LOG_LEVEL=INFO

# ── Social login (Sign in with Google / Apple) ────────────────────────────────
# Authentication only (links to an EXISTING invited user by verified email).
# Leave empty to disable; the /api/auth/oauth/* endpoints return 503 until set.
# GOOGLE_OAUTH_CLIENT_ID: Web OAuth client id from Google Cloud Console. The same
#   value must be exposed to the browser as NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID.
# APPLE_CLIENT_ID: the Apple "Services ID" configured for Sign in with Apple.
# The frontend (Next.js) needs matching public vars in frontend/.env.local:
#   NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID = (same value as GOOGLE_OAUTH_CLIENT_ID)
#   NEXT_PUBLIC_APPLE_CLIENT_ID        = (same value as APPLE_CLIENT_ID)
#   NEXT_PUBLIC_APPLE_REDIRECT_URI     = the Return URL registered with Apple
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=

# ── Property map basemap ──────────────────────────────────────────────────────
# The interactive property map (/map) works out of the box with free, no-key
# OpenStreetMap raster tiles — no value required. For production-grade tiles and
# vector glyphs, point the frontend at a provider's MapLibre style URL (e.g.
# MapTiler/Stadia). Set this in frontend/.env.local; it is exposed to the browser:
#   NEXT_PUBLIC_MAP_STYLE = https://api.maptiler.com/maps/streets/style.json?key=...
# NEXT_PUBLIC_MAP_STYLE=

# ── Connectors / Marketing insights ───────────────────────────────────────────
# Connect Meta (Facebook/Instagram) and upload exports (Business Suite CSV, Ads
# Manager CSV, "Download Your Information" JSON) to feed the Marketing Insights
# engine. The engine is rule-based today; benchmarks below are tunable.
INSIGHTS_GENERATOR=rules
INSIGHTS_ENGAGEMENT_BENCHMARK=0.03
INSIGHTS_MIN_POSTS_PER_WEEK=3
INSIGHTS_TARGET_ROAS=2.0
INSIGHTS_MAX_CPA=50
INSIGHTS_MIN_CTR=0.01
INSIGHTS_STALE_DAYS=30
# FUTURE (unused now): live OAuth sync + LLM-generated insights.
META_APP_ID=
META_APP_SECRET=
META_OAUTH_REDIRECT_URI=
ANTHROPIC_API_KEY=

# ── Predictive lead scoring (machine learning) ────────────────────────────────
# The model learns conversion probability from your won/lost history. It trains
# in-process (pure Python, no extra dependency) and stores artifacts in the DB.
#   rules   = deterministic scoring only (default; no behaviour change)
#   shadow  = compute + store the learned probability, keep rules as the grade
#             (use this to validate model lift before flipping the UI)
#   learned = surface the learned conversion probability to users
SCORER_MODE=rules
ML_MIN_TRAINING_LABELS=40   # min labeled leads before a scope trains its own model
ML_STALE_OPEN_DAYS=120      # an untouched open lead older than this = soft loss
ML_MIN_OUTCOMES_TO_SURFACE=150  # labeled outcomes an account needs before users see ML scores
ML_L2=1.0                   # logistic-regression L2 regularization
ML_LR=0.1                   # learning rate
ML_EPOCHS=600               # gradient-descent iterations
ML_RETRAIN_HOUR=3           # UTC hour of the nightly retrain job
# Whether the nightly retrain is scheduled at all. Off by default — below
# ML_MIN_TRAINING_LABELS real labeled outcomes it rebuilds approximate examples
# from every property row nightly for a model SCORER_MODE=rules never shows.
# Flip to true (env var + restart) once you have real won/lost outcomes; nothing
# is lost meanwhile, since labels are derived from current lead state and catch
# up in one pass. POST /api/ml/retrain works either way.
ML_RETRAIN_ENABLED=false
# Retrain resource caps. The retrain runs inside the API process, so these are
# what stop a big account from OOM-ing or pegging the whole web service. One
# Harris County ZIP is ~20k properties. Raise them only if you move the scheduler
# to a dedicated worker.
ML_MAX_TRAINING_ROWS=20000  # labeled rows held in memory per scope (newest outcomes win)
ML_MAX_FIT_ROWS=4000        # rows fed to the gradient loop (cost = epochs x rows x features)
ML_STREAM_BATCH=2000        # server-side fetch / UPDATE flush size

# ── Property data sources ─────────────────────────────────────────────────────
# RentCast — seeds the address list and fills year_built/value/sale/owner.
RENTCAST_API_KEY=
# Attom — assessor detail; fills garage/lot AND value/sale/owner/year gaps.
ATTOM_API_KEY=
# Google Geocoding — fills latitude/longitude/geohash.
GOOGLE_GEOCODE_KEY=
# US Census ACS — fills zip_median_income. Optional; raises rate limits if set.
CENSUS_API_KEY=
# Harris County assessor DuckDB (free, local) — permits + pool/slab + backfill.
PERMIT_DB_PATH=/path/to/harris_county.duckdb

# ── Property backfill / verification sweep (pipeline/backfill.py) ─────────────
# Account-wide gap-fill and re-check, separate from the per-ZIP pipeline step.
# Days a paid lookup is trusted before the row is eligible again. Without this a
# field the source cannot fill (sale price in non-disclosure states like Texas)
# would re-bill every row on every run. 0 disables re-checking entirely.
PROPERTY_RECHECK_DAYS=90
# Hard cap on lookups per sweep — the ceiling on what one run can spend.
PROPERTY_BACKFILL_MAX=500
# Seconds between lookups (RentCast's published limit is 20 req/s).
PROPERTY_BACKFILL_DELAY=0.05
# How far two sources may differ on a money/area figure before it is treated as a
# real discrepancy rather than rounding, as a fraction of the larger value.
PROPERTY_VALUE_TOLERANCE_PCT=0.05

# ── Contact / skip-trace (fills contact_name/phone/email) ─────────────────────
# Leave CONTACT_PROVIDER empty to skip contact enrichment entirely.
# Supported: batchdata, versium  (add more in pipeline/contact.py PROVIDERS)
# For BatchData: set CONTACT_PROVIDER=batchdata and CONTACT_API_KEY=<batchdata token>.
#   CONTACT_BASE_URL is optional — defaults to BatchData's Skip Trace endpoint
#   (https://api.batchdata.com/api/v1/property/skip-trace).
# For Versium: set CONTACT_PROVIDER=versium and CONTACT_API_KEY=<versium key>.
#   CONTACT_BASE_URL is optional (defaults to https://api.versium.com/v2/contact).
# This powers BOTH the batch pipeline contact step AND the per-lead "Enrich"
# button (POST /leads/{id}/enrich).
CONTACT_PROVIDER=
CONTACT_API_KEY=
CONTACT_BASE_URL=
CONTACT_MAX_ROWS_PER_ZIP=200
# Optional: only skip-trace leads at/above this grade (A best). Empty = no gate.
CONTACT_MIN_GRADE=

# ── Reverse phone append for inbound calls (phone → address/name/email) ──────
# Independent of CONTACT_* above, so the batch skip-trace and the inbound-call
# append can run on different providers (e.g. CONTACT_PROVIDER=batchdata for
# skip-tracing AND PHONE_APPEND_PROVIDER=versium for caller address append).
# When a call hits a tracking number, the caller's number is appended onto their
# lead — one paid attempt per caller, flagged in enrichment_flags.phone_append.
# Supported (pipeline/contact.py PHONE_APPEND_PROVIDERS):
#   batchdata — Reverse Skip Trace. 100 numbers per request, and the only one
#               that returns line type (mobile vs landline) + DNC/litigator.
#               Defaults to https://api.batchdata.com/api/v3/property/reverse-skip-trace
#               (note v3 — the forward skip-trace above is a v1 route).
#   versium   — Contact Append, one GET per number.
#               Defaults to https://api.versium.com/v2/contact
#   PHONE_APPEND_BASE_URL is optional; empty uses the provider's default above.
# Leave PHONE_APPEND_PROVIDER empty to disable the inbound-call append.
PHONE_APPEND_PROVIDER=
PHONE_APPEND_API_KEY=
PHONE_APPEND_BASE_URL=
# Daily backfill (api/call_append_sweep.py) for missed-call leads the webhook
# couldn't append inside Twilio's 15s window. MAX is the per-run lookup cap and
# 0 disables the sweep — raise it deliberately, every lookup is billed.
PHONE_APPEND_SWEEP_MAX=0
PHONE_APPEND_SWEEP_DAYS=30

# ── Household demographics / life-events (Versium Demographic Append, paid) ────
# Fills owner age/income/credit/net-worth/life-events + scoring signals (refi,
# credit, home-improvement, children, gardening). Separate Versium product from
# Contact Append above — phone/email come from the contact step, demographics
# from here. Leave DEMO_PROVIDER empty to skip this step entirely.
# Supported: batchdata, versium  (add more in pipeline/demographics.py PROVIDERS)
# For BatchData: set DEMO_PROVIDER=batchdata and DEMO_API_KEY=<batchdata token>.
#   DEMO_BASE_URL is optional — defaults to BatchData's Property Search endpoint
#   (https://api.batchdata.com/api/v1/property/search), which is where owner
#   demographics live (skip-trace returns contact info only, not demographics).
# For Versium: set DEMO_PROVIDER=versium and DEMO_API_KEY=<versium key>.

DEMO_BASE_URL=
DEMO_MAX_ROWS_PER_ZIP=200
# Optional: only enrich leads at/above this grade (A best). Empty = no gate.
DEMO_MIN_GRADE=

# ── Storm / hail events (NOAA/IEM Local Storm Reports, free, no key) ──────────
# Matches recent hail/wind/tornado events to geocoded properties for the
# roofing/hvac/fencing/pressure_washing storm scoring signal.
IEM_LSR_URL=https://mesonet.agron.iastate.edu/geojson/lsr.php
# NWS point API — maps each ZIP's centroid to its forecast office. Free, no key,
# but NWS asks callers to identify themselves.
NWS_POINTS_URL=https://api.weather.gov/points
NWS_USER_AGENT=axon-crm (storm enrichment)
# Fallback forecast office, used only when the per-ZIP lookup fails. Every ZIP
# resolves its own office at runtime, so this needs no change per market.
STORM_WFO=HGX
STORM_LOOKBACK_MONTHS=24
# Lookback is fetched in slices this wide; IEM truncates a response at 10k
# features without saying so. 6 leaves ~2x headroom at the busiest office.
STORM_FETCH_CHUNK_MONTHS=6
STORM_MATCH_RADIUS_MI=1.0
STORM_HAIL_TARGET_IN=1.5

# ── Cost / tuning knobs ───────────────────────────────────────────────────────
# Cap Attom (paid) lookups per ZIP.
ATTOM_MAX_ROWS_PER_ZIP=500
# Equity fallback fraction of value when no mortgage/sale data is available.
EQUITY_FALLBACK_PCT=0.6
# HTTP retry/backoff for all outbound API calls.
HTTP_RETRIES=3
HTTP_BACKOFF=0.5

# ── Invoice / quote delivery (email + SMS) ────────────────────────────────────
# Leave empty to disable a channel; the send routes report per-channel failures.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The platform-wide fallback sender, used for accounts without a tracking
# number of their own. It MUST be a number (or Messaging Service SID, MG…)
# owned by the project TWILIO_ACCOUNT_SID identifies — a number bought under a
# different project or subaccount fails every send with Twilio 21659 ("'From'
# … is not a Twilio phone number"). E.164 preferred; a bare 10-digit US number
# is normalized. GET /api/sms/diagnostics (owner) checks this against Twilio.
TWILIO_FROM_NUMBER=
# Browser calling (power dialer). Create a standard API Key (SK… SID + secret)
# and a TwiML App whose Voice Request URL points at
# <PUBLIC_API_BASE_URL>/api/public/twilio/voice/outbound — see
# docs/TWILIO_SETUP.md "Browser calling". Leave all three empty to keep the
# dialer in click-through tel: mode.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Platform-owner address for internal alerts: new self-serve signups, landing
# page prospect captures, and the daily unverified-signup digest. Leave empty
# to disable; requires RESEND_* above to actually send.
ADMIN_NOTIFICATION_EMAIL=
# Frontend origin used to build customer-facing links (public quote/pay pages).
APP_BASE_URL=http://localhost:3000
# The API's own public origin — used for the Twilio voice webhook URLs set on
# purchased call-tracking numbers. Empty = derived from the incoming request.
PUBLIC_API_BASE_URL=

# ── Website lead intake (insure-auto public site) ─────────────────────────────
# Authenticates server-to-server calls from insure-auto's Next.js API routes
# (POST /api/public/website-lead) via a shared-secret X-Axon-Api-Key header —
# the browser never sees this key. Leave PUBLIC_INTAKE_API_KEY empty to disable
# the endpoint (it returns 503). Generate a long random value and copy it into
# insure-auto's own AXON_API_KEY env var (Vercel Preview + Production).
PUBLIC_INTAKE_API_KEY=
# The single agency account new website leads are written to (this deployment
# serves one agency). Find your account id via `SELECT id FROM accounts;`.
PUBLIC_INTAKE_ACCOUNT_ID=

# ── Online payments (Stripe Connect Express) ──────────────────────────────────
# Platform secret key (sk_test_... / sk_live_...). Leave empty to disable — the
# Stripe endpoints return 503 and invoices send without a pay link.
STRIPE_SECRET_KEY=
# Signing secret of the CONNECT webhook endpoint ("events on connected
# accounts") pointed at /api/public/stripe/webhook. Direct charges emit their
# events on the connected account, so a platform-scoped endpoint won't see them.
STRIPE_WEBHOOK_SECRET=
# Platform fee taken on each charge, percent of the amount (2.0 = 2%).
STRIPE_PLATFORM_FEE_PCT=2.0

# ── Self-serve signup ─────────────────────────────────────────────────────────
# POST /auth/signup + OAuth first-login provisioning create a new org + owner
# (on by default). Set to false for the old invite-only model. Verification and
# password-reset emails ride the RESEND_* config above — without it, signup
# still works and reset requests are accepted but no email goes out.
SELF_SERVE_SIGNUP=true
# Days a new self-serve account keeps the full `pro` module set before the daily
# scheduler job downgrades it to `starter` (core CRM stays fully usable).
TRIAL_DAYS=14

# ── Subscription billing (Stripe Billing for Axon plans) ─────────────────────
# How accounts pay for Axon itself (separate from Stripe Connect above, same
# platform STRIPE_SECRET_KEY). Create one recurring monthly Price per plan in
# the Stripe dashboard and paste the price_... ids here; leave empty to keep
# billing admin-managed via scripts/set_account_plan.py (endpoints return 503).
# STRIPE_BILLING_WEBHOOK_SECRET is the signing secret of a PLATFORM webhook
# endpoint ("events on your account") pointed at /api/public/stripe/billing-webhook
# with events: checkout.session.completed, customer.subscription.created/updated/deleted.
STRIPE_BILLING_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# ── Meta ad conversion tracking (Pixel + Conversions API) ─────────────────────
# Two halves that share an event_id so Meta dedups instead of double-counting:
#   1. Browser Pixel — set NEXT_PUBLIC_META_PIXEL_ID in frontend/.env.local
#      (same value as META_PIXEL_ID below). Unset = pixel never loads.
#   2. Server CAPI (api/connectors/meta_capi.py) — the vars below. Sends the
#      conversions the browser can't see, above all the trial→paid Subscribe on
#      the billing webhook. Empty token/pixel = CAPI disabled (best-effort no-op).
# Generate the token in Events Manager → your dataset → Settings → Conversions
# API. META_TEST_EVENT_CODE (Events Manager → Test Events) routes emits to the
# test stream only — set it while verifying, then clear it in production.
# For EMQ ≥ 8, also enable Automatic Advanced Matching in Events Manager.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_API_VERSION=v20.0
META_TEST_EVENT_CODE=

# ── Public ZIP-sample widget (landing-page growth loop) ───────────────────────
# "Enter your ZIP, see your best leads free." Point this at a dedicated demo
# org's account id; its scored properties are served (masked — no contact info
# or full addresses) by GET /api/public/zip-sample. Leave empty to disable the
# widget. With autorun on, a ZIP the demo org hasn't scored yet queues one free
# HCAD-seeded pipeline run (Harris County only), capped per hour.
PUBLIC_SAMPLE_ACCOUNT_ID=
PUBLIC_SAMPLE_AUTORUN=true
PUBLIC_SAMPLE_RUNS_PER_HOUR=4
PUBLIC_SAMPLE_TOP_N=10

# ── Pipeline run watchdog ─────────────────────────────────────────────────────
# Wall-clock ceiling (seconds) for a single pipeline run. The scheduler shares
# the web process's thread pool, so an unbounded run holds a worker and blocks
# everything queued behind it. On expiry the run is cancelled with
# error='timeout'. Also bounds how long a `running` row may sit before the
# stale-run sweep reconciles it. 0 disables the watchdog.
RUN_MAX_SECONDS=3600

# ── Seed source ───────────────────────────────────────────────────────────────
# Where step 1 gets its address list: "rentcast" (paid; default) or "hcad" (free
# local Harris County data — seeds every parcel in the ZIP and pre-fills the
# assessor fields, so RentCast/Attom only fill the gaps). CLI: --seed-source hcad.
SEED_SOURCE=rentcast

# ── Seed property-type filter ─────────────────────────────────────────────────
# Only these RentCast propertyType values are seeded; everything else (Apartment,
# Multi-Family, Land, etc.) is skipped before paid enrichment. Set to * for all.
SEED_PROPERTY_TYPES=Single Family,Condo,Townhouse,Manufactured

# ── Search-area expansion (when a ZIP returns too few seed rows) ──────────────
SEED_EXPAND_ENABLED=true
SEED_EXPAND_THRESHOLD=50
SEED_EXPAND_TARGET=200
SEED_EXPAND_RADIUS_MI=5
SEED_EXPAND_MAX_ZIPS=10
